{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  // Type-check debt: these TypeScript tests predate strict test checking.
  // Remove an entry once its file passes; do not add new ones.
  "exclude": [
    "tests/pipeline.test.ts",
    "tests/trace-consumer.test.ts",
    "tests/delivery.test.ts",
    "tests/lyo-credit-fidelity.test.ts",
    "tests/adaptive-control-experiment.test.ts",
    "tests/report-cli.test.ts",
    "tests/session-ended.test.ts",
    "tests/candidate-at-bat.test.ts",
    "tests/activation-cli.test.ts"
  ]
}
