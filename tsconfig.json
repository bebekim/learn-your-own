{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/package.test.ts",
    "tests/eval-report.test.ts",
    "tests/native-feedback.test.ts",
    "tests/session-finding-feedback.test.ts",
    "tests/session-finding-evidence.test.ts",
    "tests/prospective-finding.test.ts",
    "tests/ordinary-finding-trials.test.ts",
    "tests/finding-trial-policy.test.ts",
    "tests/session-finding-semantics.test.ts",
    "tests/session-finding-capture.test.ts",
    "tests/helpers/session-finding-fixture.ts",
    "tests/helpers/finding-trial-fixture.ts"
  ]
}
