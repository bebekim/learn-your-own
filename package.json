{
  "name": "lyo-kernel",
  "version": "0.4.3-adaptive.25",
  "description": "SQLite reducer kernel for evidence-backed agent learning protocols.",
  "type": "module",
  "files": [
    "src",
    "docs/adaptive-feedback-loop.md",
    "docs/task-feedback-cycle.md",
    "docs/scoped-session-findings.md",
    "docs/typed-decisions.md",
    "docs/prospective-finding-trials.md",
    "docs/first-real-task-handoff.md",
    "docs/candidate-at-bat-telemetry-spec.md",
    "docs/deterministic-classification.md",
    "docs/learned-context-thermodynamics.md",
    "docs/product-learning-log.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "bin": {
    "lyo": "./src/cli.ts",
    "awok": "./src/cli.ts",
    "lyo-session-hook": "./src/lyo/selection/session-hook.ts",
    "wok": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:npm": "node scripts/build-npm.mjs",
    "test": "node --import ./tests/helpers/isolate-env.mjs --test \"tests/**/*.test.{js,ts}\"",
    "typecheck": "tsc --noEmit",
    "lyo:init": "node src/cli.ts init --db .agent-learning/learning.sqlite",
    "lyo:report": "node src/cli.ts report --db .agent-learning/learning.sqlite",
    "eval:validate": "node src/cli.ts eval validate",
    "demo": "node src/cli.ts demo fixture-replay",
    "pack:local": "node scripts/pack-npm.mjs",
    "docs:gen": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "publish:registry": "node scripts/publish-npm.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bebekim/learn-your-own.git"
  },
  "keywords": [
    "agent-learning",
    "sqlite",
    "reducer",
    "codex",
    "workflow"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
