{
  "version": "lyo.plan.v1",
  "planId": "plan-example-1",
  "specRef": {
    "path": "tests/fixtures/contract/spec.json",
    "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "stages": [
    {
      "stageId": "stage-code",
      "role": "code-writer",
      "executor": {
        "kind": "kimi-cli",
        "model": "kimi-code/kimi-for-coding",
        "temperature": 0.2
      },
      "authority": {
        "read": ["tests/fixtures/contract/spec.json"],
        "write": ["generated/src"],
        "forbiddenRead": ["generated/tests"],
        "forbiddenWrite": ["generated/tests"]
      },
      "inputs": [
        {
          "path": "tests/fixtures/contract/spec.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ],
      "outputs": ["generated/src"]
    },
    {
      "stageId": "stage-test",
      "role": "test-writer",
      "executor": {
        "kind": "openrouter",
        "model": "upstage/solar-pro-3",
        "temperature": 0.7
      },
      "authority": {
        "read": ["tests/fixtures/contract/spec.json"],
        "write": ["generated/tests"],
        "forbiddenRead": ["generated/src"],
        "forbiddenWrite": ["generated/src"]
      },
      "inputs": [
        {
          "path": "tests/fixtures/contract/spec.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ],
      "outputs": ["generated/tests"]
    },
    {
      "stageId": "stage-verify",
      "role": "verifier",
      "authority": {
        "read": ["generated/src", "generated/tests"],
        "write": ["generated/report"],
        "forbiddenRead": [],
        "forbiddenWrite": ["generated/src", "generated/tests"]
      },
      "inputs": [],
      "outputs": ["generated/report"]
    }
  ],
  "feedbackPolicy": { "codeWriterSees": "aggregate_only" },
  "stateless": true
}
